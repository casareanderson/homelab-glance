# Only for the Home Assistant build (glance.yaml). glance-flash.yaml needs no secrets:
# WiFi and the warden token are both set on the device during setup.
# Copy to secrets.yaml (gitignored) and fill in.
wifi_ssid: "YourWiFi"
wifi_password: "..."
api_key: "generate with: openssl rand -base64 32"
ota_password: "..."
