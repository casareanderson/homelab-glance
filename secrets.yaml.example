# Copy to secrets.yaml (gitignored) and fill in.

# glance-home.yaml (everything baked in, no on-device setup):
wifi_ssid: "YourWiFi"
wifi_password: "..."
warden_token: "wdn_PASTE_YOUR_TOKEN_HERE"   # warden: Settings > Connect > New token. No "Bearer ".

# glance.yaml (Home Assistant build) also needs:
api_key: "generate with: openssl rand -base64 32"
ota_password: "..."
